# Postgres
POSTGRES_USER=gip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gip_trans
# Хост-порт для публикации Postgres наружу (полезно, если 5432 на машине уже занят,
# например другим окружением); опционально, по умолчанию 5432.
# POSTGRES_HOST_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://gip:change-me@postgres:5432/gip_trans
ENVIRONMENT=development
# 5173/5174 — Vite dev-серверы (npm run dev); 8080/8081 — production-контейнеры
# frontend/admin из этого же docker-compose.
CORS_ALLOW_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:8080", "http://localhost:8081"]

# Google OAuth Client ID (Web application) — см. docs/admin-guide.md.
GOOGLE_OAUTH_CLIENT_ID=

# Секрет, которым backend подписывает собственные сессионные JWT.
# В проде — сгенерировать случайную строку (например `openssl rand -hex 32`) и не публиковать.
JWT_SECRET=dev-insecure-secret-change-me

# S3-совместимое хранилище фото чеков. В деве — MinIO из этого docker-compose.
# S3_ENDPOINT_URL — внутренний адрес (backend ходит по docker-сети).
# S3_PUBLIC_ENDPOINT_URL — адрес, доступный из браузера (вшивается в presigned-ссылки).
# В проде оба обычно совпадают с реальным адресом S3-провайдера.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=gip-trans-receipts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# MinIO (только для дев-окружения; в проде — реальный S3-провайдер вместо этого сервиса)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend/app-admin — Vite вшивает эти значения в бандл на этапе сборки,
# поэтому они здесь нужны и для docker-compose build (см. frontend/admin services).
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=

# Хост-порты production-контейнеров frontend/admin (опционально).
# FRONTEND_HOST_PORT=8080
# ADMIN_HOST_PORT=8081
