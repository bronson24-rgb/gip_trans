# Postgres
POSTGRES_USER=gip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gip_trans
# Хост-порт для публикации Postgres наружу (полезно, если 5432 на машине уже занят,
# например другим окружением); опционально, по умолчанию 5432.
# POSTGRES_HOST_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://gip:change-me@postgres:5432/gip_trans
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000
